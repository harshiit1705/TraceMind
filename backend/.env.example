# TraceMind Backend Environment Configuration

APP_NAME="TraceMind API"
APP_VERSION="0.2.3a"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL 16)
DATABASE_URL="postgresql+psycopg2://tracemind:tracemind_secret@localhost:5432/tracemind_db"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# CORS Allowed Origins (Frontend dev servers)
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'

# Demo & Simulation Mode
# When True: provides deterministic mock data and auto-seeds database on startup
DEMO_MODE=true
DEFAULT_PROJECT_SLUG="core-ecommerce"

# Google Gemini AI Provider Configuration
# Set your API key for live investigations (leave blank in dev/test to use mock provider)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_TIMEOUT_SECONDS=25

