# ==============================================================================
# TraceMind Frontend Environment Configuration Template (.env.example)
# Copy this file to frontend/.env to customize UI behavior.
# ==============================================================================

# Data Mode:
# 'api'  -> Connects to the real FastAPI backend at VITE_API_BASE_URL (Required for live tests)
# 'mock' -> Displays static in-browser mock data without requiring a running backend
VITE_DATA_MODE=api

# Backend FastAPI Base URL
VITE_API_BASE_URL=http://localhost:8000
