# ==============================================================================
# TraceMind Environment Configuration Template (.env.example)
# Copy this file to .env and fill in the values appropriate for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Settings
# ------------------------------------------------------------------------------
APP_NAME="TraceMind API"
APP_VERSION="0.2.3a"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# ------------------------------------------------------------------------------
# Database Configuration (SQLAlchemy)
# ------------------------------------------------------------------------------
# Option 1: Local PostgreSQL (Docker Compose)
DATABASE_URL="postgresql+psycopg2://tracemind:tracemind_secret@localhost:5432/tracemind_db"

# Option 2: Supabase (Transaction Pooler - Port 6543)
# Note: URL-encode any special characters in your password (e.g., '@', '#', '%')
# DATABASE_URL="postgresql+psycopg2://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"

# Option 3: Supabase (Direct Connection - Port 5432, recommended for Alembic migrations)
# DATABASE_URL="postgresql+psycopg2://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# Option 4: Local SQLite (Zero-dependency local dev and testing)
# DATABASE_URL="sqlite:///d:/TraceMind/backend/tracemind_runtime.db"

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Optional: dedicated URL for running live PostgreSQL concurrency tests
# POSTGRES_TEST_DATABASE_URL="postgresql+psycopg2://tracemind:tracemind_secret@localhost:5432/tracemind_db"

# ------------------------------------------------------------------------------
# CORS Configuration (Allowed Frontend Origins)
# ------------------------------------------------------------------------------
CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'

# ------------------------------------------------------------------------------
# Telemetry & Demo Mode
# ------------------------------------------------------------------------------
# Set to 'true' to enable deterministic simulated data and automatic project seed
DEMO_MODE=true
DEFAULT_PROJECT_SLUG="core-ecommerce"

# ------------------------------------------------------------------------------
# Google Gemini AI Provider Configuration (Live AI Incident Investigation)
# ------------------------------------------------------------------------------
# Obtain key at: https://aistudio.google.com/app/apikey
# Leave empty ("") to operate in mock/offline mode during local development & unit testing
GEMINI_API_KEY=""

# Supported models include: "gemini-2.5-flash", "gemini-1.5-flash", "gemini-3.8-flash"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIMEOUT_SECONDS=25

# ------------------------------------------------------------------------------
# Demo Microservices Network & Client Configuration (Optional overrides)
# ------------------------------------------------------------------------------
# TRACEMIND_API_URL="http://localhost:8000/api/v1"
# PROJECT_SLUG="core-ecommerce"
# ORDER_SERVICE_PORT=8001
# PAYMENT_SERVICE_PORT=8002
# INVENTORY_SERVICE_PORT=8003
# TELEMETRY_ENABLED="true"
# TELEMETRY_TIMEOUT_SECONDS=2.0

